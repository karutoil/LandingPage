---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';

/** profile.contact.kind -> Icon.astro glyph name. */
const iconFor = (kind: string) =>
  kind === 'email' ? 'mail' : kind === 'github' ? 'github' : 'discord';

const actionFor = (kind: string) => (kind === 'email' ? 'Compose email' : 'Open profile');
const isExternal = (kind: string) => kind !== 'email';

const emailLink = profile.contact.find((link) => link.kind === 'email');

const openTo = [
  'Contract engagements, 4–12 weeks',
  'LLM gateways and provider routing',
  'Agent tooling, memory, and code intelligence',
  'Platform, container, and Linux operations',
  'Infrastructure audits and reliability work',
  'Ongoing maintenance retainers',
];
---

<Layout
  title="Contact | karutoil"
  description="Reach out for contracts, infrastructure consulting, or AI tooling work — Discord, email, or GitHub."
>
  <header class="pageHead">
    <div class="wrap pageHead__in">
      <p class="kicker">Open a channel</p>
      <h1 class="pageHead__title">Contact</h1>
      <p class="pageHead__lede">
        Fastest on Discord, formal inquiries by email, and code plus ongoing experiments on GitHub.
        Tell me what you are building and I will tell you whether I can help.
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="channels-title">
    <div class="wrap">
      <div class="secHead">
        <div>
          <h2 class="secHead__title" id="channels-title">Choose a channel</h2>
          <p class="secHead__sub">
            Every row opens the real destination — no forms, no middlemen.
          </p>
        </div>
      </div>

      <ul class="channelList reveal">
        {
          profile.contact.map((link) => (
            <li>
              <a
                class="channel"
                href={link.href}
                target={isExternal(link.kind) ? '_blank' : undefined}
                rel={isExternal(link.kind) ? 'noopener noreferrer' : undefined}
              >
                <span class="channel__icon">
                  <Icon name={iconFor(link.kind)} size={22} />
                </span>

                <div class="channel__body">
                  <p class="channel__label">
                    <span>{link.label}</span>
                    <span class="chNote">{link.note}</span>
                  </p>
                  <p class="channel__handle">{link.handle}</p>
                </div>

                <span class="channel__action">
                  {actionFor(link.kind)}
                  <Icon name="arrowUpRight" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="small chFallback">
        Prefer email? Write to{' '}
        <a class="linkArrow chFallback__link" href={emailLink?.href}>
          {emailLink?.handle}
          <Icon name="arrowRight" size={15} />
        </a>
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="availability-title">
    <div class="wrap">
      <div class="card reveal">
        <div class="card__body avail">
          <div class="avail__head">
            <span class="badge badge--green">
              <span class="dot dot--pulse" aria-hidden="true"></span>
              {profile.availability}
            </span>
            <span class="meta">Typical response · within 48 hours</span>
          </div>

          <h2 class="h3 avail__title" id="availability-title">What I am open to</h2>

          <ul class="list list--check list--cols avail__list">
            {openTo.map((item) => <li>{item}</li>)}
          </ul>

          <p class="meta avail__note">
            {profile.location} · Remote-first · async by default
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Note pill that rides alongside the uppercase channel label. */
  .chNote {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-3);
  }

  /* "Prefer email?" fallback line with a real, visible text link. */
  .chFallback {
    margin-top: var(--sp-6);
  }
  .chFallback__link {
    font-size: inherit;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }
  .chFallback__link:hover {
    text-decoration-color: currentColor;
  }

  /* Availability panel internals. */
  .avail__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-5);
  }
  .avail__title {
    margin-top: var(--sp-6);
  }
  .avail__list {
    margin-top: var(--sp-5);
  }
  .avail__note {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 560px) {
    .avail__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
