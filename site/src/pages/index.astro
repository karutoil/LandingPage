---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatRow from '../components/StatRow.astro';
import WorkCard from '../components/WorkCard.astro';
import TechGroup from '../components/TechGroup.astro';
import OssCard from '../components/OssCard.astro';
import { base } from '../lib/base';
import { profile } from '../data/profile';

const featured = profile.projects.filter((project) => project.featured).slice(0, 3);
---

<Layout>
  <Hero />

  <StatRow />

  <section class="section" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="secHead">
        <div>
          <h2 class="secHead__title" id="work-heading">Selected Projects</h2>
          <p class="secHead__sub">
            Gateways, agent runtimes, and platforms — each one built to hold up under real traffic.
          </p>
        </div>
        <a class="secHead__link" href={`${base}projects/`}>
          View all projects <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="workGrid">
        {featured.map((project) => <WorkCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section" id="tech-stack" aria-labelledby="stack-heading">
    <div class="wrap">
      <div class="secHead">
        <div>
          <h2 class="secHead__title" id="stack-heading">Tech Stack</h2>
          <p class="secHead__sub">
            The tools I reach for daily, grouped by the layer they live in.
          </p>
        </div>
        <a class="secHead__link" href={`${base}experience/`}>
          See how it fits together <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="techGrid">
        {profile.stackGroups.map((group) => <TechGroup group={group} />)}
      </div>
    </div>
  </section>

  <section class="section" id="open-source" aria-labelledby="oss-heading">
    <div class="wrap">
      <div class="secHead">
        <div>
          <h2 class="secHead__title" id="oss-heading">Open Source</h2>
          <p class="secHead__sub">
            Public repos I maintain — from LLM infrastructure to agent code intelligence.
          </p>
        </div>
        <a class="secHead__link" href="https://github.com/karutoil" target="_blank" rel="noopener noreferrer">
          All {profile.projects.length} repositories <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="ossGrid">
        {profile.oss.map((repo) => <OssCard repo={repo} />)}
      </div>
    </div>
  </section>
</Layout>
